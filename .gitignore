node_modules
dist
.DS_Store
.env

# Ignore the output video from Git but not videos you import into src/.
out

# 成片以外的导出（透明角标、动图、单独的配乐、风格样图）
exports/

# 每期的原始素材
refer

# 各期共用的乐器采样库（VCSL、VSCO 2 CE，CC0，共约 6 GB），某一期用到的采样剪好后放进那一期的 public/ 入库
samples/

# 公共资料库：只有说明和目录入库，里面的图片、文章、音乐只留本机
library/*
!library/README.md
!library/INDEX.md

# 截图脚本用的登录令牌
tools/**/tokens.json
__pycache__

# 2MRS 的使用条款不允许再分发，由 tools/horizon/build_data.py 从 refer/ 生成
public/horizon/data/local.bin

# 仓库是公开的：有版权的配乐和个人照片不入库（墨衡 OJ 的 bgm.wav 是 tools/common/music.py 合成的，照常入库）
public/**/*.mp3
public/*/photos/
# 从网上摘的动漫片段同样不入库，由 tools/moe/prepare.py 在本机生成
public/moe/clips/
# 亚马逊河的高程、河网和卫星底图体积大，由 tools/amazon/build_data.py 在本机生成
public/amazon/data/
public/amazon/textures/land.jpg
# 汉字的演变：字形数据和配乐由 tools/hanzi/ 下的脚本在本机生成；语音识别程序和模型体积大
public/hanzi/data/
public/hanzi/audio/bgm.wav
tools/hanzi/whisper.cpp/
tools/hanzi/whisper.json
# 那一天：配乐由 tools/that-day/music.py 在本机生成
public/that-day/audio/bgm.wav
# 你好，我是 Claude：配乐和说话声由 tools/hello/music.py 在本机生成
public/hello/audio/
# 宇宙的尽头：念白是朋友的录音，配乐由 tools/edge/music.py 在本机生成
public/edge/audio/
tools/edge/whisper.json
tools/edge/whisper.log

# 星云：念白是朋友的录音（降噪后的成品放在 public/nebula/audio/），配乐由 tools/nebula/music.py 在本机生成
public/nebula/audio/
tools/nebula/whisper-seg.json
tools/nebula/whisper.log
tools/nebula/music.log

# 巨引源：续长的配乐是原曲拼的，不入库；数据由 tools/attractor/ 的脚本在本机生成
public/attractor/audio/
public/attractor/data/

# sfizz 的 Windows 命令行（BSD-2，从 github.com/sfztools/sfizz 的 1.2.3 发布页下载 win64 包，只留 sfizz_render.exe 和 sfizz.dll）
tools/sfizz/
tools/attractor/whisper-*.json
tools/attractor/whisper.log
public/attractor/img/
public/attractor/video/
