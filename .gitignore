node_modules
dist
.DS_Store
.env

# Ignore the output video from Git but not videos you import into src/.
out

# 每期的原始素材
refer

# 各期共用的乐器采样库（VCSL、VSCO 2 CE，CC0，共约 6 GB），某一期用到的采样剪好后放进那一期的 public/ 入库
samples/

# 截图脚本用的登录令牌
tools/**/tokens.json
__pycache__

# 2MRS 的使用条款不允许再分发，由 tools/horizon/build_data.py 从 refer/ 生成
public/horizon/data/local.bin

# 仓库是公开的：有版权的配乐和个人照片不入库（墨衡 OJ 的 bgm.wav 是 tools/music.py 合成的，照常入库）
public/**/*.mp3
public/*/photos/
# 从网上摘的动漫片段同样不入库，由 tools/moe/prepare.py 在本机生成
public/moe/clips/
# 亚马逊河的高程、河网和卫星底图体积大，由 tools/amazon/build_data.py 在本机生成
public/amazon/data/
public/amazon/textures/land.jpg
# 汉字的演变：字形数据和配乐由 tools/hanzi/ 下的脚本在本机生成；语音识别程序和模型体积大
public/hanzi/data/
public/hanzi/audio/bgm.wav
tools/hanzi/whisper.cpp/
tools/hanzi/whisper.json
# 那一天：配乐由 tools/that-day/music.py 在本机生成
public/that-day/audio/bgm.wav
# 你好，我是 Claude：配乐和说话声由 tools/hello/music.py 在本机生成
public/hello/audio/
